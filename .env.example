# Anker Protocol — Somnia Edition (Shannon testnet, chainId 50312)
# Copy to `.env.local`. NEVER commit `.env*` — see .gitignore.

# --- Somnia Shannon testnet ---
# Public alias RPC. The SDK's `somniaShannon` chain also carries
# https://api.infra.testnet.somnia.network as its primary endpoint.
SOMNIA_RPC=https://dream-rpc.somnia.network
WS_RPC=wss://dream-rpc.somnia.network/ws
# DreamDEX / Somnia Markets indexer (testnet tier).
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Same three, exposed to the browser bundle for the wagmi client.
NEXT_PUBLIC_SOMNIA_RPC=https://dream-rpc.somnia.network
NEXT_PUBLIC_WS_RPC=wss://dream-rpc.somnia.network/ws
NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# WalletConnect Cloud project id (https://cloud.reown.com). Public by design.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical / Open Graph absolute URL base.
NEXT_PUBLIC_SITE_URL=https://www.ankerprotocol.xyz

# --- AnkerNote deployment (filled by Task 3's deploy script) ---
# NEXT_PUBLIC_ANKER_NOTE_ADDRESS=

# --- scripts/smoke.ts ONLY: burner key, testnet, zero value ---
# Fund with STT gas from https://testnet.somnia.network, then run `npm run smoke`.
# tUSDC is self-funded by the script via the SDK faucet.
# Never reuse a key that holds anything. Never commit this file.
BURNER_PRIVATE_KEY=

# --- Benchmark Recorder (server-only) ---
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# CRON_SECRET=
